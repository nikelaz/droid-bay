# Copy to .env and fill in. Variables already set in the shell are overridden by this file.

# GitHub token (required) — used by the GitHub MCP server
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# LLM provider: openai (default) | anthropic | openrouter
# LLM_PROVIDER=openai

# Provider API key matching LLM_PROVIDER (required)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# OPENROUTER_API_KEY=sk-or-...

# Web search: MCP server (no API key required). Default endpoint:
# https://search.parallel.ai/mcp (Parallel web search).
# Override the endpoint with WEB_SEARCH_URL, or run a local stdio MCP
# search server with WEB_SEARCH_MCP_CMD.
# WEB_SEARCH_URL=https://search.parallel.ai/mcp
# WEB_SEARCH_MCP_CMD='npx -y some-mcp-search-server'

# Codebase access: if -codebase is not passed, the agent removes any previous
# checkout and re-clones owner/repo into .codebases/<owner>/<repo> (shallow).
# All filesystem tools are exposed; the system prompt restricts use to read-only.
# CODEBASE_MCP_CMD='npx -y @modelcontextprotocol/server-filesystem /path/to/repo'

# Override the GitHub MCP server command line.
# Default: npx -y @modelcontextprotocol/server-github
# The official github-mcp-server -stdio binary works too.
# GITHUB_MCP_CMD=